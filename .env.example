# Copy to .env (gitignored) and fill. Cluster-side orchestrator secrets only —
# none of these ever reach a pod (pods see presigned URLs + per-run tokens).
HF_TOKEN=
GPUAI_API_KEY=
RUNPOD_API_KEY=
GROQ_AI_API_KEY=

# Image registries (SPEC §3): canonical = cluster Forgejo; cloud mirror =
# ghcr.io built by GitHub Actions on tag push (repo mirrored forgejo→github).
CANONICAL_REF=pi00.lan:30080/quadra/trainer
MIRROR_REF=ghcr.io/iqns-org/trainer

# Only for scripts/sync-image.sh pushing INTO the canonical registry
# (public ghcr needs no SRC_* creds):
#   e.g. a Forgejo bot user with a write:packages token
DST_USER=
DST_TOKEN=

# Corpora linkage (SPEC §4b): sibling checkout of quadra/corpora (private,
# never mirrored). Unset = legacy in-repo datasets/ during migration.
CORPORA_DIR=../corpora

# RustFS S3 lane (SPEC §8, P1): orchestrator mints presigned URLs; pods never
# see these keys. Access/secret come from infra's s3-credentials secret.
S3_ENDPOINT=http://pi00.lan:30900
S3_BUCKET=quadra-ml
S3_ACCESS_KEY=
S3_SECRET_KEY=

# If the ghcr package is kept PRIVATE, provider-side pull credentials:
#   RunPod:  POST /v2/registries  (see docs/SPEC.md §3)
#   GPU.ai:  gpu registry-credentials
# A fine-grained PAT scoped to this repo, read:packages, is enough.

# local provider ($0 K8s-Jobs on the cluster)
LOCAL_SSH_HOST=me@pi00.lan
LOCAL_WORKDIR=/srv/mcps/trainer
# LOCAL_LANE_DIR=/app            # inside mcp-trainer pod (direct-fs mode)
# LOCAL_GPU_OFFER=1              # advertise Orin/nano GPU offer
