#!/usr/bin/env python3
import hashlib
import json
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))
from expand import main_all


def holdout_key(line: str) -> str:
    """The bucket IDENTITY of a row: its conversation's first message
    (normalized), falling back to the whole line when there is no
    conversation. Template siblings share this key."""
    try:
        msgs = json.loads(line).get("messages") or []
        first = " ".join((msgs[0].get("content") or "").split())
    except Exception:
        first = ""
    return first or line.strip()


def is_holdout(line: str) -> bool:
    """Holdout law v2 (2026-11-27): bucket by TEMPLATE, not row content.
    synth profile measured the v1 row-hash split LEAKING ~100%: every
    templated-family holdout row had sibling variants in train (uniq
    0.006 in diagnosis), so holdout NLL measured memorization. Keying
    on the first message moves every variant of a scenario across the
    line together — the model trains on NO template it is scored on.
    13am stability holds: the key is content-derived, so a template
    held out in round K is held out forever."""
    return int(hashlib.sha256(holdout_key(line).encode())
               .hexdigest()[:8], 16) % 50 == 0


def prepare_domain(domain: str) -> Path:
    main_all([domain])

    expanded_root = ROOT / "tmp" / domain
    files = sorted(expanded_root.rglob("*.jsonl"))
    if not files:
        raise SystemExit(f"no expanded jsonl files under {expanded_root}")

    final_path = ROOT / "tmp" / f"{domain}.jsonl"
    holdout_path = ROOT / "tmp" / f"{domain}.holdout.jsonl"
    total_rows = 0
    held = 0
    # HOLDOUT LAW (SPEC 13am): every conversation is bucketed by content
    # hash, never by position — a line that trains in round K still trains
    # in round K+5, and a line held out is held out forever. That stability
    # is what makes cross-round eval trends honest (round-2 lesson: loss
    # dropped while behavior flattened — no unseen split to reveal it).
    with final_path.open("w", encoding="utf-8") as out, \
            holdout_path.open("w", encoding="utf-8") as hold:
        for path in files:
            with path.open("r", encoding="utf-8") as src:
                for line in src:
                    line = line.strip()
                    if not line:
                        continue
                    if is_holdout(line):           # stable ~2%
                        hold.write(line + "\n")
                        held += 1
                    else:
                        out.write(line + "\n")
                        total_rows += 1

    shutil.rmtree(expanded_root, ignore_errors=True)
    print(f"prepared {domain}: {len(files)} source files -> {final_path} "
          f"({total_rows} train + {held} holdout)")
    return final_path


if __name__ == "__main__":
    if len(sys.argv) != 2:
        raise SystemExit("usage: prepare-domain {domain}")
    prepare_domain(sys.argv[1])
