#!/usr/bin/env python3
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))
from expand import main_all


def prepare_domain(domain: str) -> Path:
    main_all([domain])

    expanded_root = ROOT / "tmp" / domain
    files = sorted(expanded_root.rglob("*.jsonl"))
    if not files:
        raise SystemExit(f"no expanded jsonl files under {expanded_root}")

    final_path = ROOT / "tmp" / f"{domain}.jsonl"
    total_rows = 0
    with final_path.open("w", encoding="utf-8") as out:
        for path in files:
            with path.open("r", encoding="utf-8") as src:
                for line in src:
                    if line.strip():
                        out.write(line)
                        total_rows += 1

    shutil.rmtree(expanded_root, ignore_errors=True)
    print(f"prepared {domain}: {len(files)} source files -> {final_path} ({total_rows} rows)")
    return final_path


if __name__ == "__main__":
    if len(sys.argv) != 2:
        raise SystemExit("usage: prepare-domain {domain}")
    prepare_domain(sys.argv[1])
