#!/usr/bin/env python3
"""Graph IR PASS 1 sanity check (RDF-blind). Wraps src/ir-ast-sanity.py."""
import importlib.util
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
venv = ROOT / ".venv" / "bin" / "python"
if venv.is_file() and os.path.realpath(sys.executable) != os.path.realpath(str(venv)):
    os.execv(str(venv), [str(venv), str(Path(__file__).resolve())] + sys.argv[1:])

spec = importlib.util.spec_from_file_location("ir_ast_sanity", ROOT / "src" / "ir-ast-sanity.py")
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

raise SystemExit(mod.main())
