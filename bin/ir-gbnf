#!/usr/bin/env python3
"""ir-gbnf — Graph IR grammar as GBNF + mirror generator. Wraps src/ir-gbnf.py."""
import importlib.util
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
venv = ROOT / ".venv" / "bin" / "python"
if venv.is_file() and os.path.realpath(sys.executable) != os.path.realpath(str(venv)):
    os.execv(str(venv), [str(venv), str(Path(__file__).resolve())] + sys.argv[1:])

import importlib.machinery
_candidate = ROOT / "src" / "ir-gbnf.py"
spec = importlib.util.spec_from_file_location(
    "ir_gbnf", str(_candidate),
    loader=importlib.machinery.SourceFileLoader("ir_gbnf", str(_candidate)))
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

raise SystemExit(mod.main())
