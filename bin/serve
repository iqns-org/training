#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT_DIR"

usage() {
  echo "Usage: $0 <domain> [--host 0.0.0.0] [--port 8000] [--base|--lora] [--base-model MODEL] [--adapter-dir DIR]" >&2
  exit 1
}

if [ "$#" -lt 1 ]; then
  usage
fi

domain="$1"
shift

args=("$domain")
while [ "$#" -gt 0 ]; do
  case "$1" in
    --host|--port|--base-model|--adapter-dir|--base|--lora)
      if [ "$#" -lt 2 ] && [ "$1" != "--base" ] && [ "$1" != "--lora" ]; then
        usage
      fi
      if [ "$1" = "--base" ] || [ "$1" = "--lora" ]; then
        args+=("$1")
        shift
      else
        args+=("$1" "$2")
        shift 2
      fi
      ;;
    -h|--help)
      usage
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

serve_base=0
for arg in "${args[@]}"; do
  if [ "$arg" = "--base" ]; then
    serve_base=1
    break
  fi
done

if [ "$serve_base" -eq 0 ] && [ ! -d "$ROOT_DIR/outputs/$domain" ]; then
  echo "Error: no local model artifacts found for domain '$domain' under $ROOT_DIR/outputs/$domain" >&2
  exit 1
fi

if [ ! -f "$ROOT_DIR/.venv/bin/python" ]; then
  echo "Error: project virtualenv not found at $ROOT_DIR/.venv" >&2
  exit 1
fi

if [ ! -f "$ROOT_DIR/src/serve_llm.py" ]; then
  echo "Error: server entrypoint not found at $ROOT_DIR/src/serve_llm.py" >&2
  exit 1
fi

"$ROOT_DIR/.venv/bin/python" "$ROOT_DIR/src/serve_llm.py" "${args[@]}"
