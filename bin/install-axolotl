#!/usr/bin/env bash
set -Eeuo pipefail

###############################################################################
# Axolotl installer
#
# Usage:
#   ./install-axolotl.sh
#
# Optional:
#   PYTHON=python3.11 VENV=.venv-axolotl ./install-axolotl.sh
#
# The script:
#   - verifies Python
#   - creates an isolated venv
#   - upgrades pip/setuptools/wheel
#   - installs PyTorch
#   - installs Axolotl
#   - verifies torch/CUDA
#   - verifies axolotl CLI
#   - emits useful diagnostics on failure
###############################################################################

PYTHON="${PYTHON:-python3.11}"
VENV="${VENV:-$HOME/.venvs/axolotl}"
TORCH_INDEX="${TORCH_INDEX:-https://download.pytorch.org/whl/cu128}"

log() {
    printf '\n\033[1;36m==> %s\033[0m\n' "$*"
}

warn() {
    printf '\n\033[1;33mWARNING: %s\033[0m\n' "$*" >&2
}

die() {
    printf '\n\033[1;31mERROR: %s\033[0m\n' "$*" >&2
    exit 1
}

cleanup_on_error() {
    local rc=$?
    echo
    echo "Axolotl installation failed."
    echo
    echo "Environment:"
    echo "  Python: $PYTHON"
    echo "  Venv:   $VENV"
    echo
    if [[ -x "$VENV/bin/python" ]]; then
        "$VENV/bin/python" --version || true
        "$VENV/bin/python" -m pip --version || true
    fi
    echo
    echo "If this is a PyTorch/torchvision compatibility problem,"
    echo "check the versions printed above before changing packages."
    exit "$rc"
}

trap cleanup_on_error ERR

###############################################################################
# Pre-flight
###############################################################################

log "Checking host"

command -v "$PYTHON" >/dev/null 2>&1 \
    || die "$PYTHON not found"

PYTHON_VERSION="$("$PYTHON" -c 'import sys; print(".".join(map(str, sys.version_info[:3])))')"

echo "Python: $PYTHON_VERSION"

"$PYTHON" - <<'PY'
import sys

if sys.version_info < (3, 10):
    raise SystemExit("Python 3.10+ is required")

if sys.version_info >= (3, 13):
    raise SystemExit(
        "Python 3.13+ is intentionally rejected. "
        "Use Python 3.10/3.11/3.12 for maximum ML package compatibility."
    )
PY

###############################################################################
# NVIDIA check
###############################################################################

log "Checking NVIDIA environment"

if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=name,driver_version,memory.total \
        --format=csv,noheader || true
else
    warn "nvidia-smi not found. Continuing, but CUDA acceleration may not work."
fi

###############################################################################
# Create venv
###############################################################################

log "Creating virtual environment"

if [[ ! -d "$VENV" ]]; then
    "$PYTHON" -m venv "$VENV"
else
    echo "Using existing venv: $VENV"
fi

VENV_PYTHON="$VENV/bin/python"
VENV_PIP="$VENV/bin/pip"

[[ -x "$VENV_PYTHON" ]] || die "Virtual environment Python missing"

###############################################################################
# Upgrade packaging tools
###############################################################################

log "Upgrading packaging tools"

"$VENV_PYTHON" -m pip install \
    --upgrade \
    pip \
    setuptools \
    wheel

###############################################################################
# Basic environment diagnostics
###############################################################################

log "Python environment"

"$VENV_PYTHON" --version
"$VENV_PIP" --version

###############################################################################
# Install PyTorch
#
# Keep this explicit. Axolotl sits on top of PyTorch and installing Axolotl
# first allows pip to make decisions that can produce incompatible torch /
# torchvision / torchaudio combinations.
###############################################################################

log "Installing PyTorch"

"$VENV_PYTHON" -m pip install \
    --index-url "$TORCH_INDEX" \
    torch \
    torchvision \
    torchaudio

###############################################################################
# Verify PyTorch before touching Axolotl
###############################################################################

log "Verifying PyTorch"

"$VENV_PYTHON" - <<'PY'
import sys

import torch
import torchvision

print("Python:       ", sys.version.split()[0])
print("PyTorch:      ", torch.__version__)
print("Torchvision:  ", torchvision.__version__)
print("CUDA built:   ", torch.version.cuda)
print("CUDA available:", torch.cuda.is_available())

if torch.cuda.is_available():
    print("GPU count:    ", torch.cuda.device_count())
    for i in range(torch.cuda.device_count()):
        print(f"GPU {i}:        ", torch.cuda.get_device_name(i))
else:
    print("WARNING: CUDA is not available to PyTorch.")
PY

###############################################################################
# Install Axolotl
###############################################################################

log "Installing Axolotl"

"$VENV_PYTHON" -m pip install \
    --no-cache-dir \
    "axolotl[deepspeed]"

###############################################################################
# Dependency consistency check
###############################################################################

log "Checking dependency consistency"

"$VENV_PYTHON" -m pip check

###############################################################################
# Axolotl CLI smoke test
###############################################################################

log "Testing Axolotl CLI"

if ! "$VENV/bin/axolotl" --help >/dev/null; then
    die "Axolotl CLI failed its smoke test"
fi

"$VENV/bin/axolotl" --version 2>/dev/null || true

###############################################################################
# Final diagnostics
###############################################################################

log "Final environment"

echo
echo "Python:"
"$VENV_PYTHON" --version

echo
echo "PyTorch:"
"$VENV_PYTHON" -c \
    'import torch; print(torch.__version__, "CUDA:", torch.version.cuda, "available:", torch.cuda.is_available())'

echo
echo "Axolotl:"
"$VENV/bin/axolotl" --help >/dev/null
echo "CLI OK"

echo
echo "Installed packages:"
"$VENV_PIP" list | grep -Ei \
    '^(torch|torchvision|torchaudio|axolotl|transformers|accelerate|peft|deepspeed|bitsandbytes)' \
    || true

###############################################################################
# Convenience activation
###############################################################################

cat <<EOF

===============================================================================

Axolotl installed successfully.

Activate:

    source "$VENV/bin/activate"

Then:

    axolotl --help

Python:

    $VENV_PYTHON

Venv:

    $VENV

===============================================================================
EOF

